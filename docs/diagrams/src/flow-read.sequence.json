  ],
  "segments": [
    { "from": 150, "to": 190, "label": "Request" },
    { "from": 196, "to": 262, "label": "Once per term" },
    { "from": 268, "to": 400, "label": "ReadIndex" },
    { "from": 408, "to": 490, "label": "Stale read" }
  ],
  "messages": [
    { "id": "get", "from": "client", "to": "leader", "y": 170, "label": "Get(k, LINEARIZABLE)", "variant": "emphasis" },
    { "id": "barrier", "from": "leader", "to": "followers", "y": 210, "label": "barrier: commit an entry of this term", "variant": "dashed" },
    { "id": "barrier-ack", "from": "followers", "to": "leader", "y": 240, "label": "committed", "variant": "return" },
    { "id": "verify", "from": "leader", "to": "followers", "y": 285, "label": "VerifyLeader heartbeat", "variant": "security" },
    { "id": "verify-ack", "from": "followers", "to": "leader", "y": 315, "label": "ack from majority", "variant": "return", "note": "commit := CommitIndex(); wait until FSM.applied ≥ commit (the FSM tracks its own index)" },
    { "id": "get-resp", "from": "leader", "to": "client", "y": 385, "label": "GetResponse{value, version, index = commit}", "variant": "return" },
    { "id": "stale", "from": "client", "to": "anynode", "y": 425, "label": "Get(k, STALE)", "variant": "default" },
    { "id": "stale-resp", "from": "anynode", "to": "client", "y": 460, "label": "value from the local FSM, index = applied", "variant": "return" }
