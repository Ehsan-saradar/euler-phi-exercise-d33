  "activations": [
    { "participant": "leader", "from": 165, "to": 392, "type": "backend" },
    { "participant": "followers", "from": 205, "to": 246, "type": "backend" },
    { "participant": "followers", "from": 280, "to": 321, "type": "backend" },
    { "participant": "anynode", "from": 420, "to": 466, "type": "backend" }
  ],
  "cards": [
    { "dot": "cyan", "title": "Why the barrier", "items": ["A new leader learns the true commit index only after committing an entry of its own term (Raft §8)", "Memoised per term, so it costs one entry per leadership change"] },
    { "dot": "emerald", "title": "Why wait on the FSM", "items": ["raft.AppliedIndex advances when an entry is handed to the FSM, not when it is applied", "The FSM keeps its own applied index; the read waits until it reaches commit"] },
    { "dot": "orange", "title": "Stale reads", "items": ["No coordination, no network round trip", "Keep working on the minority side of a partition; callers re-validate by index"] }
  ]
