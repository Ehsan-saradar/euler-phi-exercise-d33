  "cards": [
    {
      "dot": "cyan",
      "title": "One port per node",
      "items": [
        "cmux splits :7000 into gRPC (clients and forwards), HTTP/1 (Prometheus, health) and raft's own protocol",
        "The raft advertise address is the API address, so followers forward to the leader without discovery"
      ]
    },
    {
      "dot": "emerald",
      "title": "Write and read paths",
      "items": [
        "Writes: api \u2192 Propose \u2192 boltdb append (fsync) \u2192 replicate \u2192 majority \u2192 FSM.Apply",
        "Linearizable reads: ReadIndex (VerifyLeader + wait for FSM applied index); stale reads answer from any FSM"
      ]
    },
    {
      "dot": "rose",
      "title": "Fault injection",
      "items": [
        "ChaosLayer wraps the raft transport: block peers, drop inbound, freeze traffic",
        "Driven by Admin.Partition in tests; docker compose kill/pause in e2e"
      ]
    }
  ]
